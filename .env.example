# OpenAI API key for live agent documentation research via web search
OPENAI_API_KEY=your_openai_api_key_here

# Optional model override (default: gpt-4o)
# OPENAI_MODEL=gpt-4o

# Web-search tool identifier
# "web_search_preview" is standard across accounts; use "web_search" if enabled on your account.
OPENAI_WEBSEARCH_TOOL=web_search_preview
